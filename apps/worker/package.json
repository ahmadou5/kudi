{
  "name": "@kudi/worker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build:deps": "pnpm --filter @kudi/types build && pnpm --filter @kudi/chains build && pnpm --filter @kudi/database build && pnpm --filter @kudi/payment-providers build",
    "build": "pnpm build:deps && tsup src/index.ts --format cjs,esm",
    "dev": "tsx watch src/index.ts",
    "start": "pnpm --filter @kudi/database db:generate && node dist/index.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@kudi/chains": "workspace:*",
    "@kudi/database": "workspace:*",
    "@kudi/payment-providers": "workspace:*",
    "@kudi/types": "workspace:*",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "tsx": "^4.7.1",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
