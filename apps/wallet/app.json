{
  "expo": {
    "name": "Kudi",
    "slug": "kudi",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kudi",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#090A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kudi.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kudi.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SmoochSans-ExtraBold.ttf",
            "./assets/fonts/ShareTechMono-Regular.ttf",
            "./assets/fonts/Inter-Bold.ttf"
          ]
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "368e5114-1468-4e89-bc29-c2b1f9827da6"
      }
    }
  }
}
