{
  "expo": {
    "name": "Kudi",
    "slug": "kudi",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kudi",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#090A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kudi.app"
    },
    "android": {
      "package": "com.kudi.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SmoochSans-ExtraBold.ttf",
            "./assets/fonts/ShareTechMono-Regular.ttf",
            "./assets/fonts/Inter-Bold.ttf"
          ]
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
