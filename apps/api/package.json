{
  "name": "@kudi/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build:deps": "pnpm --filter @kudi/types build && pnpm --filter @kudi/chains build && pnpm --filter @kudi/database build && pnpm --filter @kudi/payment-providers build && pnpm --filter @kudi/kyc build && pnpm --filter @kudi/cards build && pnpm --filter @kudi/receipts build && pnpm --filter @kudi/sdk build",
    "build": "pnpm build:deps && tsup src/server.ts --format cjs,esm",
    "dev": "tsx watch src/server.ts",
    "start": "pnpm --filter @kudi/database db:generate && node dist/server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/redis": "^9.0.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@kudi/cards": "workspace:*",
    "@kudi/chains": "workspace:*",
    "@kudi/database": "workspace:*",
    "@kudi/kyc": "workspace:*",
    "@kudi/payment-providers": "workspace:*",
    "@kudi/receipts": "workspace:*",
    "@kudi/types": "workspace:*",
    "@sentry/node": "^7.114.0",
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^3.7.0",
    "fastify": "^5.12.3",
    "fastify-plugin": "^4.5.1",
    "socket.io": "^4.8.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/socket.io": "^3.0.2",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
