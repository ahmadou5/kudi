datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum KYCTier {
  UNVERIFIED
  TIER_1
  TIER_2
}

enum KYCStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id              String             @id @default(uuid())
  privyUserId     String?            @unique
  phoneNumber     String?            @unique
  email           String?            @unique
  fullName        String?
  username        String?
  avatarUrl       String?
  role            String             @default("USER")
  passwordHash    String?
  status          String             @default("ACTIVE")
  expoPushToken   String?
  kycTier         KYCTier            @default(UNVERIFIED)
  kycStatus       KYCStatus          @default(NOT_STARTED)
  pinHash         String?
  wallets         Wallet[]
  ledger          LedgerEntry[]
  spends          SpendTransaction[]
  virtualAccounts VirtualAccount[]
  notifications   Notification[]
  withdrawals     Withdrawal[]
  balanceAccounts BalanceAccount[]
  deposits        Deposit[]
  spendLimitEntries SpendLimitEntry[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model VirtualAccount {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountNumber String
  accountName   String
  bankName      String
  bankCode      String
  currency      String   @default("NGN")
  provider      String
  createdAt     DateTime @default(now())

  @@unique([provider, accountNumber])
}

model Wallet {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain         String
  address       String    @unique
  tokenAddress  String?
  privyWalletId String?
  custodyType   String    @default("SERVER_CUSTODY")
  metadata      String?
  createdAt     DateTime  @default(now())
}



model Deposit {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletAddress String
  chain         String
  tokenSymbol   String
  amountUSDC    Float
  signature     String   @unique
  blockNumber   Int?
  privyWalletId String?  // Privy server wallet ID for signing sweeps (null = float/self-custody model)
  creditStatus  String   @default("CREDITED")
  sweepStatus   String   @default("SWEEP_PENDING")
  sweepTxHash        String?
  sweepError         String?
  sweepAttemptCount Int      @default(0)
  nextSweepAttemptAt DateTime @default(now())
  creditedAt         DateTime @default(now())
  sweptAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([sweepStatus, nextSweepAttemptAt])
  @@index([sweepStatus, createdAt])
  @@index([chain, createdAt])
}

model BalanceAccount {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset         String   @default("USDC")
  availableUSDC Float    @default(0)
  reservedUSDC  Float    @default(0)
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, asset])
  @@index([userId])
}

model LedgerEntry {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 String
  amountUSDC           Float
  resultingBalanceUSDC Float
  referenceId          String
  metadata             String?
  createdAt            DateTime @default(now())

  @@index([userId, createdAt])
  @@unique([type, referenceId])
}


model Withdrawal {
  id            String   @id @default(uuid())
  reference     String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountUSDC    Float
  toAddress     String
  chain         String
  status        String   @default("PENDING")
  txHash        String?
  blockNumber   Int?
  attemptCount  Int      @default(0)
  nextAttemptAt DateTime @default(now())
  failureReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}

model SpendTransaction {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference              String   @unique
  amountUSDC             Float
  exchangeRateNGN        Float
  amountNGN              Float
  feeNGN                 Float
  recipientBankCode      String
  recipientAccountNumber String
  recipientAccountName   String
  payoutProvider         String
  status                 String   @default("PENDING")
  failureReason          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId])
  @@index([reference])
}

model ChainConfiguration {
  id                    String   @id @default(uuid())
  chainId               String   @unique
  name                  String
  type                  String
  rpcUrl                String
  tokenContractAddress  String
  confirmationThreshold Int      @default(12)
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ProviderConfiguration {
  id        String   @id @default(uuid())
  provider  String   @unique
  name      String
  enabled   Boolean  @default(true)
  priority  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RateFeedLog {
  id          String   @id @default(uuid())
  source      String
  bidRate     Float
  askRate     Float
  blendedRate Float
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("SYSTEM")
  read      Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ProcessedSignature {
  signature String   @id
  createdAt DateTime @default(now())
}

model ProcessedWebhook {
  id             String   @id @default(uuid())
  provider       String
  eventId        String
  idempotencyKey String   @unique
  eventType      String?
  payload        String?
  createdAt      DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, createdAt])
}

model WorkerHeartbeat {
  id        String   @id
  role      String
  hostname  String?
  pid       Int?
  lastSeen  DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([role, lastSeen])
}

model SpendLimitWindow {
  id        String   @id @default(uuid())
  userId    String
  spentDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, spentDate])
  @@index([userId, spentDate])
}

model SpendLimitEntry {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference       String    @unique
  sourceType      String
  amountUSDC      Float
  amountNGN       Float
  limitNGN        Float
  spentDate       DateTime
  status          String    @default("APPLIED")
  releasedAt      DateTime?
  releaseReason   String?
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, spentDate, status])
  @@index([reference])
}

model ReconciliationSnapshot {
  id                         String   @id @default(uuid())
  totalLiabilityUSDC         Float    @default(0)
  totalAvailableUSDC         Float    @default(0)
  totalReservedUSDC          Float    @default(0)
  pendingSweepUSDC           Float    @default(0)
  processingSweepUSDC        Float    @default(0)
  sweptUSDC                  Float    @default(0)
  sweepFailedUSDC            Float    @default(0)
  floatExposureUSDC          Float    @default(0)
  unsupportedSweepUSDC       Float    @default(0)
  pendingWithdrawalUSDC      Float    @default(0)
  processingWithdrawalUSDC   Float    @default(0)
  broadcastWithdrawalUSDC    Float    @default(0)
  metadata                   String?
  createdAt                  DateTime @default(now())

  @@index([createdAt])
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actorEmail String?
  action    String
  targetType String
  targetId  String
  details   String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model OperatorAlert {
  id          String   @id @default(uuid())
  type        String
  severity    String
  status      String   @default("OPEN")
  title       String
  body        String
  reference   String?
  metadata    String?
  acknowledgedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, severity, createdAt])
  @@unique([type, reference])
  @@index([type, reference])
}

model AppConfig {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GasDrip {
  id            String   @id @default(uuid())
  walletAddress String
  chain         String
  amountNative  Float
  txHash        String   @unique
  trigger       String
  status        String   @default("BROADCAST")
  createdAt     DateTime @default(now())

  @@index([walletAddress, createdAt])
  @@index([chain, createdAt])
}

