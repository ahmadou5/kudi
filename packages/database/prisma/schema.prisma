datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum KYCTier {
  UNVERIFIED
  TIER_1
  TIER_2
}

enum KYCStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id              String             @id @default(uuid())
  privyUserId     String?            @unique
  phoneNumber     String?            @unique
  email           String?            @unique
  fullName        String?
  username        String?
  avatarUrl       String?
  expoPushToken   String?
  kycTier         KYCTier            @default(UNVERIFIED)
  kycStatus       KYCStatus          @default(NOT_STARTED)
  pinHash         String?
  wallets         Wallet[]
  ledger          LedgerEntry[]
  spends          SpendTransaction[]
  virtualAccounts VirtualAccount[]
  notifications   Notification[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model VirtualAccount {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountNumber String
  accountName   String
  bankName      String
  bankCode      String
  currency      String   @default("NGN")
  provider      String
  createdAt     DateTime @default(now())
}

model Wallet {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain        String
  address      String    @unique
  tokenAddress String?
  createdAt    DateTime  @default(now())
}

model LedgerEntry {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 String
  amountUSDC           Float
  resultingBalanceUSDC Float
  referenceId          String
  metadata             String?
  createdAt            DateTime @default(now())

  @@index([userId, createdAt])
}

model SpendTransaction {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference              String   @unique
  amountUSDC             Float
  exchangeRateNGN        Float
  amountNGN              Float
  feeNGN                 Float
  recipientBankCode      String
  recipientAccountNumber String
  recipientAccountName   String
  payoutProvider         String
  status                 String   @default("PENDING")
  failureReason          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId])
  @@index([reference])
}

model ChainConfiguration {
  id                    String   @id @default(uuid())
  chainId               String   @unique
  name                  String
  type                  String
  rpcUrl                String
  tokenContractAddress  String
  confirmationThreshold Int      @default(12)
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ProviderConfiguration {
  id        String   @id @default(uuid())
  provider  String   @unique
  name      String
  enabled   Boolean  @default(true)
  priority  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RateFeedLog {
  id          String   @id @default(uuid())
  source      String
  bidRate     Float
  askRate     Float
  blendedRate Float
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("SYSTEM")
  read      Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ProcessedSignature {
  signature String   @id
  createdAt DateTime @default(now())
}
