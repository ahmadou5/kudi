{
  "name": "@kudi/database",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsup src/index.ts --format cjs,esm --dts",
    "db:generate": "prisma generate",

    "db:push": "prisma db push",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "prisma": "^5.10.2"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
