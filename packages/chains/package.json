{
  "name": "@kudi/chains",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "build:runtime": "tsup src/index.ts --format cjs,esm"
  },
  "dependencies": {
    "@kudi/types": "workspace:*",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.3.0",
    "ethers": "^6.11.1",
    "@kudi/chains-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
