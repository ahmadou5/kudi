# ==============================================================================
# KUDI MONOREPO — EXAMPLE ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values.
# Shared across: apps/api, apps/wallet, apps/worker, apps/web, apps/admin
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
API_BASE_URL="https://your-api.up.railway.app/"
KUDI_API_URL="http://localhost:4000"

# Admin Authentication
# Required in ALL environments (no dev bypass). Send as `x-admin-key` header.
ADMIN_API_KEY="your-strong-admin-api-key-here"
ADMIN_PASSWORD="your-admin-password-here"

# Public API URL for Mobile App & Web Frontend (Expo / Next.js)
EXPO_PUBLIC_API_URL="https://your-api.up.railway.app/"
NEXT_PUBLIC_API_URL="https://your-api.up.railway.app/"

# ------------------------------------------------------------------------------
# 2. DATABASE & CACHE (PostgreSQL / Neon & Redis)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/kudi_dev"
REDIS_URL="redis://default:password@your-redis-host:6379"
ENABLE_REDIS="true"

# ------------------------------------------------------------------------------
# 3. PRIVY AUTHENTICATION & EMBEDDED WALLETS
# ------------------------------------------------------------------------------
PRIVY_APP_ID="your-privy-app-id-here"
PRIVY_APP_SECRET="your-privy-app-secret-here"
PRIVY_CLIENT_ID="client-your-privy-client-id-here"

# Public Privy IDs for frontend clients
EXPO_PUBLIC_PRIVY_APP_ID="your-privy-app-id-here"
EXPO_PUBLIC_PRIVY_CLIENT_ID="client-your-privy-client-id-here"
NEXT_PUBLIC_PRIVY_APP_ID="your-privy-app-id-here"

# Pila Privy NewClient pattern - key quorum and authorization
# Verification key (PEM format ECDSA public key) for authorizing Privy RPC calls
PRIVY_VERIFICATION_KEY_PEM="-----BEGIN EC PUBLIC KEY-----\nMEUCIBICAQE...\n-----END EC PUBLIC KEY-----"
# Wallet owner key quorum ID - identifies the key quorum owner
PRIVY_WALLET_OWNER_KEY_QUORUM_ID="wok_..."
# Authorization private key (base64) - used for Privy signed RPC requests
PRIVY_AUTHORIZATION_PRIVATE_KEY_B64="base64encodedprivatekey..."
# Authorization key ID - maps to the above private key in Privy's system
PRIVY_AUTHORIZATION_KEY_ID="auth_key_id_..."

# Optional: default user wallet ID for Stellar base-transaction signing fallback
PRIVY_USER_WALLET_ID=""

# ------------------------------------------------------------------------------
# 4. MULTI-PROVIDER NGN PAYOUT & BANK INGESTION CREDENTIALS
# Payout rails: SQUAD | BACHS (Bachs is the default).
# ------------------------------------------------------------------------------

# VA provisioning + payout rail selection (SQUAD | BACHS)
ACTIVE_PAYMENT_PROVIDER="BACHS"

SQUAD_SECRET_KEY="squad_secret_key_here"
SQUAD_PUBLIC_KEY="squad_public_key_here"

KORAPAY_SECRET_KEY="korapay_secret_key_here"
KORAPAY_PUBLIC_KEY="korapay_public_key_here"

# Bachs (default payout rail + VA provider)
BACHS_SECRET_KEY="sk_sandbox_your_bachs_secret_key_here"
BACHS_BASE_URL="https://sandbox-api.bachs.io"
# Per-endpoint signing secret from Bachs Developer Portal → Webhooks (NOT the API key)
BACHS_WEBHOOK_SIGNING_SECRET="whsec_your_bachs_webhook_signing_secret_here"

# ------------------------------------------------------------------------------
# 5. KYC IDENTITY VERIFICATION PROVIDERS (Dojah | Sumsub)
# The active provider is switched from the admin dashboard (Settings page);
# IDENTITY_PROVIDER below is only the fallback when no admin selection exists.
# ------------------------------------------------------------------------------
# Optional fallback selection: DOJAH | SUMSUB
IDENTITY_PROVIDER="DOJAH"

# Dojah — https://dashboard.dojah.io (App ID + API Key)
DOJAH_API_KEY=""
DOJAH_APP_ID=""
# Hosted flow (WebView) — Widget ID of a published EasyOnboard flow
# (Dashboard → EasyOnboard → your flow → Widget ID). Required for the
# in-app hosted verification screen.
DOJAH_WIDGET_ID=""

# Sumsub — https://cockpit.sumsub.com → Developers → App tokens
# SUMSUB_LEVEL_NAME must match a verification level configured in Sumsub
# (the E-KYC / Non-Doc step for Nigeria BVN + NIN must be enabled).
SUMSUB_APP_TOKEN=""
SUMSUB_APP_SECRET=""
SUMSUB_LEVEL_NAME="basic-kyc-level"
# SUMSUB_BASE_URL="https://api.sumsub.com"

# Public base URL of this API — used to build the Sumsub WebSDK page URL
# opened inside the app's WebView. Falls back to the request host if unset.
# PUBLIC_API_URL="https://api.yourdomain.com"

# Simulated KYC (dev-only). Explicit opt-in — non-production alone is not
# enough. Must never be true in production (boot fails if NODE_ENV=production
# and this is true). Leave unset/false on shared staging/QA.
# IDENTITY_SIMULATE="true"

# ------------------------------------------------------------------------------
# 6. MULTI-CHAIN RPC & TOKEN CONTRACT CONFIGURATION
# ------------------------------------------------------------------------------
MONAD_RPC_URL="https://testnet-rpc.monad.xyz"
MONAD_RPC_URL_FALLBACK=""
AUSD_TOKEN_ADDRESS="0x0000000000000000000000000000000000000000"
MONAD_CHAIN_ID="10143"

SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
SOLANA_RPC_URL_FALLBACK=""
USDC_MINT_ADDRESS="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"

# Solana CAIP-2 chain identifier for Privy signing
#   Devnet:  solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
#   Mainnet: solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
SOLANA_CAIP2="solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1"

# EIP-712 domain fields for the AUSD/USDC contract on Monad.
# Verified on Monad testnet 2026-09-29: name()="USDC", version()="2".
# Change these only if you switch to a different token contract.
EIP712_TOKEN_NAME="USDC"
EIP712_TOKEN_VERSION="2"

# Stellar USDC issuer override (defaults: Circle testnet issuer on testnet,
# Centre USDC issuer on public). Only change for custom tokens.
STELLAR_USDC_ISSUER=""

# ------------------------------------------------------------------------------
# 7. KUDI TREASURY WALLETS (Privy Server Wallets — required for on-chain sends)
# ------------------------------------------------------------------------------
# Create treasury server wallets in the Privy dashboard → Server Wallets
# Then paste the wallet IDs and public addresses below.

# Privy Server Wallet ID for the Kudi Solana treasury (sends USDC on Solana)
KUDI_SOLANA_TREASURY_WALLET_ID="wallet_privy_id_for_solana_treasury"

# Privy Server Wallet ID for the Kudi Monad/EVM treasury (sends AUSD on Monad)
KUDI_EVM_TREASURY_WALLET_ID="wallet_privy_id_for_evm_treasury"

# The ACTUAL Solana public key address of the treasury wallet
KUDI_TREASURY_SOLANA_ADDRESS="your-solana-treasury-pubkey-here"

# The ACTUAL EVM address of the EVM treasury wallet
KUDI_TREASURY_EVM_ADDRESS="0x0000000000000000000000000000000000000000"

# ------------------------------------------------------------------------------
# 8. GAS SPONSORSHIP & CUSTODY CONFIG
# ------------------------------------------------------------------------------
# Gas payment mode for treasury sweeps.
# TREASURY_FEE_PAYER — treasury wallet pays gas; deposit wallets never need native tokens.
# PRIVY_SPONSOR is no longer supported.
GAS_PAYMENT_MODE="TREASURY_FEE_PAYER"

# Custody track: TRACK_A_SELF_CUSTODY (default, Privy) or TRACK_B_PARTNER (VASP)
CUSTODY_TRACK="TRACK_A_SELF_CUSTODY"

# Privy gas wallet IDs for sponsored transaction flows (Pila Three-Chain)
PRIVY_SOLANA_GAS_WALLET_ID="wallet_privy_id_for_solana_gas"
PRIVY_SOLANA_GAS_WALLET_PUBKEY="your-solana-gas-wallet-pubkey-here"
PRIVY_STELLAR_GAS_WALLET_ID="wallet_privy_id_for_stellar_gas"
PRIVY_STELLAR_GAS_WALLET_PUBKEY="your-stellar-gas-wallet-pubkey-here"
PRIVY_EVM_GAS_WALLET_ID="wallet_privy_id_for_evm_gas"
PRIVY_EVM_SETTLEMENT_LIQUIDITY_WALLET_ID="wallet_privy_id_for_evm_settlement_liquidity"
PRIVY_EVM_FEES_WALLET_ID="wallet_privy_id_for_evm_fees"

# Privy gas sponsorship toggles
PRIVY_SPONSOR_TRANSACTIONS="true"
PRIVY_SPONSOR_SWEEPS="true"

# Optional operator overrides (rarely needed)
WALLET_ID=""

# ------------------------------------------------------------------------------
# 9. ALCHEMY (EVM Gas Policy / RPC)
# ------------------------------------------------------------------------------
ALCHEMY_API_KEY="your-alchemy-api-key-here"
ALCHEMY_GAS_POLICY_ID="your-alchemy-gas-policy-id-here"
# Optional: explicit Alchemy wallet ID. Falls back to PRIVY_EVM_GAS_WALLET_ID when empty.
ALCHEMY_WALLET_ID=""

# ------------------------------------------------------------------------------
# 10. MONITORING & EMAIL
# ------------------------------------------------------------------------------
SENTRY_DSN=""
RESEND_API_KEY="re_..."
RESEND_FROM="Kudi <auth@yourdomain.com>"

# VASP Partner API (Track B custody)
VASP_PARTNER_API_KEY=""
VASP_PARTNER_API_URL=""
