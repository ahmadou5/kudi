# Server & Port Config
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/kudi_dev"
# Admin auth: required in ALL environments (no dev bypass). Local dev: set a
# strong value here and send it as the `x-admin-key` header, or sign in with a
# JWT whose role is ADMIN.
ADMIN_API_KEY="your-strong-admin-api-key-here"

# Custody Track A (Privy Server Wallets / KMS)
# Required in production; startup fails closed without them.
PRIVY_APP_ID="your-privy-app-id-here"
PRIVY_APP_SECRET="your-privy-app-secret-here"

# Multi-Provider NGN Payout API Credentials
PAYSTACK_SECRET_KEY="sk_test_paystack_secret_key_here"
MONNIFY_API_KEY="monnify_api_key_here"
MONNIFY_SECRET_KEY="monnify_secret_key_here"
SQUAD_SECRET_KEY="squad_secret_key_here"

# KYC Provider Credentials (Smile Identity)
SMILE_IDENTITY_PARTNER_ID="partner_id_here"
SMILE_IDENTITY_API_KEY="api_key_here"

# Multi-Chain Deposit RPC Configuration
MONAD_RPC_URL="https://testnet-rpc.monad.xyz"
# Optional secondary RPCs — used automatically when the primary fails.
MONAD_RPC_URL_FALLBACK=""
AUSD_TOKEN_ADDRESS="0x0000000000000000000000000000000000000000"
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
SOLANA_RPC_URL_FALLBACK=""
USDC_MINT_ADDRESS="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"

# Treasury addresses — REQUIRED, startup fails closed on missing/placeholder
# values. Use real devnet/testnet addresses for local development.
KUDI_TREASURY_SOLANA_ADDRESS="your-solana-treasury-pubkey-here"
KUDI_TREASURY_EVM_ADDRESS="0x0000000000000000000000000000000000000000"

# Resend Email Config
RESEND_API_KEY="re_..."
RESEND_FROM="Kudi <auth@ahmad.usekudi.fun>"
